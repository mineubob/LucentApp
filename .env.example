# ──────────────────────────────────────────────
# Database Configuration
# ──────────────────────────────────────────────

# Driver: "mysql" or "sqlite"
DB_DRIVER=mysql

# MySQL settings (required when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=my_database
DB_USERNAME=root
DB_PASSWORD=secret

# SQLite settings (required when DB_DRIVER=sqlite)
# DB_DATABASE=/storage/database.sqlite

# ──────────────────────────────────────────────
# Deployment
# ──────────────────────────────────────────────

# DEPLOY_URL=https://api.github.com/repos/your-org/your-repo/zipball/master
# DEPLOY_TOKEN=your_personal_access_token

# ──────────────────────────────────────────────
# Debug Mode
# ──────────────────────────────────────────────

# Set to "true" to include full exception traces in error responses
# DEBUG=false