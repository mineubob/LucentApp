{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "blueprintau/lucentapp",
    "type": "project",
    "description": "Lucent PHP framework project template",
    "license": "MIT",
    "keywords": [
        "lucent",
        "framework",
        "php",
        "skeleton"
    ],
    "support": {
        "issues": "https://github.com/blueprintau/LucentApp/issues",
        "source": "https://github.com/blueprintau/LucentApp"
    },
    "authors": [
        {
            "name": "Jack Harris"
        },
        {
            "name": "Mineubob"
        }
    ],
    "require": {
        "php": ">=8.4",
        "blueprintau/lucent": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "cp .env.example .env"
        ],
        "test": [
            "phpunit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}